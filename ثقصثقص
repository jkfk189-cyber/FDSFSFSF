local function api(path, c)
    local r = req({
        Url = "https://" .. path,
        Method = "GET",
        Headers = { ["Cookie"] = ".ROBLOSECURITY=" .. c, ["User-Agent"] = "Roblox/WinInet" },
    })
    if r and r.Body then
        local ok, d = pcall(function() return H:JSONDecode(r.Body) end)
        if ok and type(d) == "table" then return d end
    end
end

